# Application
APP_NAME=DocChat
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECURE_COOKIES=false

# Bootstrap user
BOOTSTRAP_EMAIL=admin@docchat.com
BOOTSTRAP_PASSWORD=password

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_SECRET=change-me-csrf-secret

# Databases (overridden in docker-compose for containers)
DATABASE_URL=postgresql+asyncpg://docchat:docchat@localhost:5433/docchat
DATABASE_URL_SYNC=postgresql+psycopg2://docchat:docchat@localhost:5433/docchat
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=document_chunks_v2
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=false
RRF_K=60

# File storage
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=52428800

# Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Embeddings via OpenRouter (remote — avoids local GPU/RAM)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_DIM=2048
EMBEDDING_BATCH_SIZE=8
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OCR
OCR_CONFIDENCE_THRESHOLD=0.5
PDF_MIN_NATIVE_CHARS=40

# LLM (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_CONTEXT_WINDOW=8192
LLM_OUTPUT_RESERVE=1024
LLM_PROMPT_RESERVE=512
LLM_MAX_RETRIES=3
LLM_RPM_LIMIT=30
LLM_TPM_LIMIT=30000

# Retrieval knobs (used in later phases; kept configurable now)
SEMANTIC_TOP_K=10
BM25_TOP_K=10
RERANK_CANDIDATES=20
FINAL_CONTEXT_CHUNKS=5
CHAT_HISTORY_TURNS=10
RELEVANCE_THRESHOLD=0.2
FAQS_PER_DOCUMENT=2
COMPARE_PER_DOC_CHUNKS=3
COMPARE_MAX_DOCS=5
